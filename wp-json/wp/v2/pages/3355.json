div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/hydroclimatol.com\/book-chapters\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">BOOK CHAPTERS<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-948ea34 elementor-align-justify elementor-widget elementor-widget-button\" data-id=\"948ea34\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/hydroclimatol.com\/technical-reports\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">TECHNICAL REPORTS<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-7c2246d elementor-align-justify elementor-widget elementor-widget-button\" data-id=\"7c2246d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/hydroclimatol.com\/conference-presentations-selected\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">CONFERENCE PRESENTATIONS (selected)<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-169125a e-con-full e-flex e-con e-child\" data-id=\"169125a\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-fdaad9d elementor-widget elementor-widget-html\" data-id=\"fdaad9d\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n    \/* \ub3c4\uc11c(Book Chapter) \uc139\uc158 \uc804\uc6a9 \uc2a4\ud0c0\uc77c *\/\r\n    #book-container { font-family: 'Malgun Gothic', sans-serif; color: #333; background: #fff; }\r\n    #book-list { list-style: none; padding: 0; margin: 0; min-height: 100px; }\r\n    .book-item { padding: 15px 10px; border-bottom: 1px solid #eee; display: flex; align-items: flex-start; }\r\n    .book-num { font-weight: bold; min-width: 45px; color: #6A6E83; font-size: 14px; }\r\n    .book-content { flex: 1; font-size: 15px; color: #333; line-height: 1.5; text-align: left; }\r\n\r\n    \/* \ud398\uc774\uc9c0\ub124\uc774\uc158 \ub514\uc790\uc778 (\ud1b5\uc77c\uac10\uc744 \uc704\ud574 \uc720\uc9c0) *\/\r\n    .pagination { display: flex; justify-content: center; align-items: center; margin-top: 30px; gap: 6px; }\r\n    .pagination button { \r\n        background-color: transparent; border: 1px solid #6A6E83; color: #6A6E83; \r\n        padding: 5px 10px; cursor: pointer; font-size: 13px; transition: all 0.2s; border-radius: 2px;\r\n    }\r\n    .pagination button:hover, .pagination button.active { \r\n        background-color: #0F172A; border-color: #0F172A; color: #ffffff; \r\n    }\r\n    .pagination button:disabled { opacity: 0.3; cursor: default; }\r\n<\/style>\r\n\r\n<div id=\"book-container\">\r\n    <ul id=\"book-list\"><\/ul>\r\n    <div class=\"pagination\" id=\"book-pagination\"><\/div>\r\n<\/div>\r\n\r\n<script>\r\n(function() {\r\n    \/\/ \ub3c4\uc11c \ub370\uc774\ud130 (1\uac1c)\r\n    const bookPapers = [\r\n        `Chun, J. A., Aikins, C. M., Kim, D., Li, S., Lee, W. and Lee. E.-J., 2019. Impacts of Climate Change on Crop Production, with Special Reference to Southeast Asia: Profiling and CoverAction. In Approaches for Enhancing Abiotic Stress Tolerance in Plants, edited by Mirza Hasanuzzaman, Kmrun Nahar, Masayuki Fujita, Hirosuke Oku, and Tofazzal Islam.`\r\n    ];\r\n\r\n    const rowsPerPage = 10;\r\n    let currentPage = 1;\r\n\r\n    function displayList(page) {\r\n        const listEl = document.getElementById('book-list');\r\n        if(!listEl) return;\r\n        listEl.innerHTML = \"\";\r\n        \r\n        let start = rowsPerPage * (page - 1);\r\n        let end = start + rowsPerPage;\r\n        let paginatedItems = bookPapers.slice(start, end);\r\n\r\n        paginatedItems.forEach((item, i) => {\r\n            let displayNum = bookPapers.length - (start + i);\r\n            let itemEl = document.createElement('li');\r\n            itemEl.className = 'book-item';\r\n            itemEl.innerHTML = `<div class=\"book-num\">${displayNum}.<\/div><div class=\"book-content\">${item}<\/div>`;\r\n            listEl.appendChild(itemEl);\r\n        });\r\n    }\r\n\r\n    function setupPagination() {\r\n        const paginationEl = document.getElementById('book-pagination');\r\n        if(!paginationEl) return;\r\n        paginationEl.innerHTML = \"\";\r\n        let pageCount = Math.ceil(bookPapers.length \/ rowsPerPage);\r\n\r\n        const addBtn = (text, onClick) => {\r\n            let btn = document.createElement('button');\r\n            btn.innerText = text;\r\n            btn.onclick = onClick;\r\n            paginationEl.appendChild(btn);\r\n            return btn;\r\n        };\r\n\r\n        addBtn(\"<<\", () => { currentPage = 1; update(); });\r\n        addBtn(\"<\", () => { if(currentPage > 1) { currentPage--; update(); } });\r\n\r\n        for (let i = 1; i <= pageCount; i++) {\r\n            let btn = addBtn(i, () => { currentPage = i; update(); });\r\n            if (currentPage === i) btn.className = 'active';\r\n        }\r\n\r\n        addBtn(\">\", () => { if(currentPage < pageCount) { currentPage++; update(); } });\r\n        addBtn(\">>\", () => { currentPage = pageCount; update(); });\r\n    }\r\n\r\n    function update() {\r\n        displayList(currentPage);\r\n        setupPagination();\r\n    }\r\n\r\n    update();\r\n})();\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-956e0fb e-flex e-con-boxed e-con e-parent\" data-id=\"956e0fb\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3583ae8 elementor-widget elementor-widget-spacer\" data-id=\"3583ae8\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>BOOK CHAPTERS PUBLICATION\u200bS PEER-REVIEWED JOURNAL ARTICLES BOOK CHAPTERS TECHNICAL REPORTS CONFERENCE PRESENTATIONS (selected)<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"site-sidebar-layout":"no-sidebar","site-content-layout":"page-builder","ast-site-content-layout":"full-width-container","site-content-style":"default","site-sidebar-style":"default","ast-global-header-display":"","ast-banner-title-visibility":"","ast-main-header-display":"","ast-hfb-above-header-display":"","ast-hfb-below-header-display":"","ast-hfb-mobile-header-display":"","site-post-title":"disabled","ast-breadcrumbs-content":"","ast-featured-img":"disabled","footer-sml