lt\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/hydroclimatol.com\/book-chapters\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">BOOK CHAPTERS<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-6c0cdf1 elementor-align-justify elementor-widget elementor-widget-button\" data-id=\"6c0cdf1\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/hydroclimatol.com\/technical-reports\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">TECHNICAL REPORTS<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-d320ab0 elementor-align-justify elementor-widget elementor-widget-button\" data-id=\"d320ab0\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"button.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div class=\"elementor-button-wrapper\">\n\t\t\t\t\t<a class=\"elementor-button elementor-button-link elementor-size-sm\" href=\"https:\/\/hydroclimatol.com\/conference-presentations-selected\/\">\n\t\t\t\t\t\t<span class=\"elementor-button-content-wrapper\">\n\t\t\t\t\t\t\t\t\t<span class=\"elementor-button-text\">CONFERENCE PRESENTATIONS (selected)<\/span>\n\t\t\t\t\t<\/span>\n\t\t\t\t\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-22b5d77 e-con-full e-flex e-con e-child\" data-id=\"22b5d77\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-0361b08 elementor-widget elementor-widget-html\" data-id=\"0361b08\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n    #paper-container-new { font-family: 'Malgun Gothic', sans-serif; color: #333; background: #fff; }\r\n    #paper-list-new { list-style: none; padding: 0; margin: 0; min-height: 300px; }\r\n    .paper-item { padding: 15px 10px; border-bottom: 1px solid #eee; display: flex; align-items: flex-start; }\r\n    .paper-num { font-weight: bold; min-width: 45px; color: #6A6E83; font-size: 14px; }\r\n    .paper-content { flex: 1; font-size: 15px; color: #333; line-height: 1.5; text-align: left; }\r\n\r\n    .pagination { display: flex; justify-content: center; align-items: center; margin-top: 30px; gap: 6px; }\r\n    .pagination button { \r\n        background-color: transparent; border: 1px solid #6A6E83; color: #6A6E83; \r\n        padding: 5px 10px; cursor: pointer; font-size: 13px; transition: all 0.2s; border-radius: 2px;\r\n    }\r\n    .pagination button:hover, .pagination button.active { \r\n        background-color: #0F172A; border-color: #0F172A; color: #ffffff; \r\n    }\r\n    .pagination button:disabled { opacity: 0.3; cursor: default; }\r\n<\/style>\r\n\r\n<div id=\"paper-container-new\">\r\n    <ul id=\"paper-list-new\"><\/ul>\r\n    <div class=\"pagination\" id=\"pagination-new\"><\/div>\r\n<\/div>\r\n\r\n<script>\r\n(function() {\r\n    \/\/ \uc694\uccad\ud558\uc2e0 6\uac1c \ub17c\ubb38 \ub9ac\uc2a4\ud2b8\r\n    const newPapers = [\r\n        `Kim, D., and Chun, J. A., 2019. Drought monitoring and analysis using a generalized complementary principle of evapotranspiration. APEC Climate Center Research Report 2018-16.`,\r\n        `Chun, J. A., Kim, D., Lee, E., Aikins, C. M., Baethgen, W., Mason, S., Robertson, A., Han, E., and Inthavong, T., 2019. Agriculture Risk Management Support (ARMS) for rain-fed lowland rice in Lao PDR II. APEC Climate Center Research Report 2018-24.`,\r\n        `Kim, D., 2018. A decision-centric assessment for water resources management in a large river basin under non-stationary climate. APEC Climate Center Research Report 2017-18.`,\r\n        `Chun, J. A., Kim, D., Lee, E., Aikins, C. M., Baethgen, W., Mason, S., Robertson, A., Han, E., and Inthavong, T., 2018. Agriculture Risk Management Support (ARMS) for rain-fed lowland rice in Lao PDR. APEC Climate Center Research Report 2017-13.`,\r\n        `Rhee, J., Yoon, S., Kim, D., Lee., S., Myoung, B., Lee, H., Moon, S., Han, S., Kim, B. R., 2018. Disaster Management Research Roadmap for the ASEAN region. An outcome from the ASEAN Science-Based Disaster Management Platform (ASDMP) Project 2016-2017.`,\r\n        `Kim, D., 2017. Analysis of historical droughts in South Korea and assessment of climate change impacts on drought and water scarcity in an agricultural river system. APEC Climate Center Research Report 2016-27.`\r\n    ].reverse(); \/\/ 6\ubc88\uc774 \ub9e8 \uc704\ub85c \uc624\ub3c4\ub85d \uc5ed\uc21c \uc815\ub82c\r\n\r\n    const rowsPerPage = 10;\r\n    let currentPage = 1;\r\n\r\n    function displayList(page) {\r\n        const listEl = document.getElementById('paper-list-new');\r\n        if(!listEl) return;\r\n        listEl.innerHTML = \"\";\r\n        \r\n        let start = rowsPerPage * (page - 1);\r\n        let end = start + rowsPerPage;\r\n        let paginatedItems = newPapers.slice(start, end);\r\n\r\n        paginatedItems.forEach((item, i) => {\r\n            let displayNum = newPapers.length - (start + i);\r\n            let itemEl = document.createElement('li');\r\n            itemEl.className = 'paper-item';\r\n            itemEl.innerHTML = `<div class=\"paper-num\">${displayNum}.<\/div><div class=\"paper-content\">${item}<\/div>`;\r\n            listEl.appendChild(itemEl);\r\n        });\r\n    }\r\n\r\n    function setupPagination() {\r\n        const paginationEl = document.getElementById('pagination-new');\r\n        if(!paginationEl) return;\r\n        paginationEl.innerHTML = \"\";\r\n        let pageCount = Math.ceil(newPapers.length \/ rowsPerPage);\r\n\r\n        \/\/ \ud56d\ubaa9\uc774 10\uac1c \uc774\ud558\uc77c \uacbd\uc6b0 \ud398\uc774\uc9c0\ub124\uc774\uc158\uc744 \uc228\uae30\ub824\uba74 \uc544\ub798 \uc870\uac74\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\r\n        \/\/ if (pageCount <= 1) return; \r\n\r\n        const addBtn = (text, onClick) => {\r\n            let btn = document.createElement('button');\r\n            btn.innerText = text;\r\n            btn.onclick = onClick;\r\n            paginationEl.appendChild(btn);\r\n            return btn;\r\n        };\r\n\r\n        addBtn(\"<<\", () => { currentPage = 1; update(); });\r\n        addBtn(\"<\", () => { if(currentPage > 1) { currentPage--; update(); } });\r\n\r\n        for (let i = 1; i <= pageCount; i++) {\r\n            let btn = addBtn(i, () => { currentPage = i; update(); });\r\n            if (currentPage === i) btn.className = 'active';\r\n        }\r\n\r\n        addBtn(\">\", () => { if(currentPage < pageCount) { currentPage++; update(); } });\r\n        addBtn(\">>\", () => { currentPage = pageCount; update(); });\r\n    }\r\n\r\n    function update() {\r\n        displayList(currentPage);\r\n        setupPagination();\r\n    }\r\n\r\n    update();\r\n})();\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-62d5d2e e-flex e-con-boxed e-con e-parent\" data-id=\"62d5d2e\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t\t<div class=\"e-con-inner\">\n\t\t<div class=\"elementor-element elementor-element-b5a27a4 e-con-full e-flex e-con e-child\" data-id=\"b5a27a4\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-e1d0ce3 elementor-widget elementor-widget-spacer\" data-id=\"e1d0ce3\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"spacer.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t<div class=\"elementor-spacer\">\n\t\t\t<div class=\"elementor-spacer-inner\"><\/div>\n\t\t<\/div>\n\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>TECHNICAL REPORTS PUBLICATION\u200bS PEER-REVIEWED JOURNAL ARTICLES BOOK CHAPTERS TECHNICAL REPORTS CONFERENCE PRESENTATIONS (selected)<\/p>\n","protected":false},"author":1,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"site-sidebar-layout":"no-sidebar","site-content-layout":"page-builder","ast-site-content-layout":"full-width-container","site-content-style":"default","site-sidebar-style":"default","ast-global-header-display":"","ast-banner-title-visibility":"","ast-main-header-display":"","ast-hfb-above-header-display":"","ast-hfb-below-header-display":"","ast-hfb-mobile-header-display":"","site-post-title":"disabled","ast-breadcrumbs-content":"","ast-featured-img":"disabled","footer-sml-layout":"","ast-disable-related-posts":"","theme-transparent-header-meta":"enabled","adv-header-id-meta":"","stick-header-meta":"","header-above-stick-meta":"","header-main-stick-meta":"","header-below-stick-meta":"","astra-migrate-meta-layouts":"set","ast-page-background-enabled":"default","ast-page-background-meta":{"desktop":{"background-color":"","background-image":"","background-repeat":"repeat","background-position":"center center","background-size":"auto","background-attachment":"scroll","background-type":"","background-media":"","overl