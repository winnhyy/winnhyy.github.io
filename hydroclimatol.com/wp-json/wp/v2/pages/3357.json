\t<\/a>\n\t\t\t\t<\/div>\n\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-dde0cc7 e-con-full e-flex e-con e-child\" data-id=\"dde0cc7\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-106163a elementor-widget elementor-widget-html\" data-id=\"106163a\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<style>\r\n    \/* \ud559\uc220\ub300\ud68c \uc139\uc158 \uc804\uc6a9 \uc2a4\ud0c0\uc77c *\/\r\n    #conf-container { font-family: 'Malgun Gothic', sans-serif; color: #333; background: #fff; }\r\n    #conf-list { list-style: none; padding: 0; margin: 0; min-height: 450px; }\r\n    .conf-item { padding: 15px 10px; border-bottom: 1px solid #eee; display: flex; align-items: flex-start; }\r\n    .conf-num { font-weight: bold; min-width: 45px; color: #6A6E83; font-size: 14px; }\r\n    .conf-content { flex: 1; font-size: 15px; color: #333; line-height: 1.5; text-align: left; }\r\n\r\n    \/* \ud398\uc774\uc9c0\ub124\uc774\uc158 \ub514\uc790\uc778 *\/\r\n    .pagination { display: flex; justify-content: center; align-items: center; margin-top: 30px; gap: 6px; }\r\n    .pagination button { \r\n        background-color: transparent; border: 1px solid #6A6E83; color: #6A6E83; \r\n        padding: 5px 10px; cursor: pointer; font-size: 13px; transition: all 0.2s; border-radius: 2px;\r\n    }\r\n    .pagination button:hover, .pagination button.active { \r\n        background-color: #0F172A; border-color: #0F172A; color: #ffffff; \r\n    }\r\n    .pagination button:disabled { opacity: 0.3; cursor: default; }\r\n<\/style>\r\n\r\n<div id=\"conf-container\">\r\n    <ul id=\"conf-list\"><\/ul>\r\n    <div class=\"pagination\" id=\"conf-pagination\"><\/div>\r\n<\/div>\r\n\r\n<script>\r\n(function() {\r\n    \/\/ 10\uac1c\uc758 \ud559\uc220\ub300\ud68c \ub370\uc774\ud130 \ub9ac\uc2a4\ud2b8\r\n    const conferencePapers = [\r\n        'Kim, D., and Kaluarachchi, J. J., 2014. Hydro-economic optimization for agricultural productivity using Bayesian estimates. AWRA Integrated Water Resources Management Conference, Reno, NV, USA.',\r\n        'Kim, D., Yoon, S., Cho, J., and Lee, K., 2015. Changes in frequency and temporal patterns of extreme rainfall events in South Korea. The 2015 KSAE Annual Conference and INWEPF WG2 International Workshop, Naju, South Korea.',\r\n        'Kim, D., and Kaluarachchi, J. J., 2016. A risk-based agro-economic analysis to maximize income of salinity-affected agricultural lands with limited water. ASCE EWRI 8th International Perspective on Water Resources and the Environment, Colombo, Sri Lanka.',\r\n        'Kim, D., and Rhee, J., 2016. Drought trends indicated by evapotranspiration deficit over the contiguous United States during 1896-2013. European Geosciences Union (EGU) 2016 General Assembly, Vienna, Austria.',\r\n        'Kim, D., Cho, J., Yoon, S., Kim, M., and Jang, S., 2016. Stochastic downscaling of CMIP5 daily precipitation for assessing climate change impacts on flood risk. 13th annual meeting of Asia Oceania Geoscience Society (AOGS), Beijing, China.',\r\n        'Kim, D., and Eum, H., 2017. Low robustness of increasing reservoir capacity for adaptation to climate change: A case study for an agricultural river basin. European Geosciences Union (EGU) 2017 General Assembly, Vienna, Austria.',\r\n        'Moursi, H., Kim, D., and Kaluarachchi, J. J., 2018. A scenario-neutral assessment of water scarcity in a snowmelt-driven agricultural river basin under climate change. 15th annual meeting of Asia Oceania Geoscience Society (AOGS), Honolulu, Hawaii, USA.',\r\n        'Kim, D., and Chun, J. A., 2019. A risk-based decision-centric assessment of water supply capacity in a complex river basin under climate change. European Meteorological Society (EMS) 2019 Annual Meeting, Lyngby, Denmark.',\r\n        'Kim, D., and Chun, J. A., 2021. Two parameters are required for a Budyko function to describe the land-atmosphere interaction. European Geosciences Union (EGU) 2021 General Assembly, online.',\r\n        'Kim, D., and Chun, J. A., 2022. Linking the Budyko framework with the complementary evaporation principle for proper consideration of surface energy availability. European Geosciences Union (EGU) 2022 General Assembly, online.',\r\n        'Kim, D., Chun, J. A., Yeo, J. H., Ha, K. J.,  2022. Future flash drought risks overrated by plants stomatal response to rising atmospheric CO2, AGU Fall Meeting Abstracts 2022, GC55A-04.',\r\n        \r\n        'Kim, D. Chun, J. A., 2023. Changes in global evaporation for the past four decades identified by the complementary evaporation principle and the Budyko framework, EGU General Assembly Conference Abstracts, EGU-4642.',\r\n        'Ha, K. J., Yeo, J. H., Kim, D., Lee, H., 2024. Drought risks based on changes in atmospheric evaporative demand due to plant response to CO2 levels, European Geosciences Union General Assembly 2024 (EGU24), 7210. ',\r\n        'Lee, S. C., Kim, D., 2025. Performance evaluation of coupled conceptual and machine-learning frameworks for streamflow prediction in ungauged basins, EGU General Assembly Conference Abstracts, EGU25-3948.',\r\n        'Lee, S. C., Kim, D., Jang, S. H., 2026. Quantifying carbon sequestration capacity of potential wetland restoration in South Korea using a high-resolution dynamic vegetation model, EGU26.',\r\n        'Kim, D., Choi, M., 2026. Why offline aridity diagnostics overestimate future drying: the role of feedback-inflated evaporative demand, EGU26.'\r\n        \r\n\r\n    ].reverse(); \/\/ \ucd5c\uc2e0\uc21c \uc815\ub82c (10\ubc88\uc774 \uc704\ub85c)\r\n\r\n    const rowsPerPage = 10;\r\n    let currentPage = 1;\r\n\r\n    function displayList(page) {\r\n        const listEl = document.getElementById('conf-list');\r\n        if(!listEl) return;\r\n        listEl.innerHTML = \"\";\r\n        \r\n        let start = rowsPerPage * (page - 1);\r\n        let end = start + rowsPerPage;\r\n        let paginatedItems = conferencePapers.slice(start, end);\r\n\r\n        paginatedItems.forEach((item, i) => {\r\n            let displayNum = conferencePapers.length - (start + i);\r\n            let itemEl = document.createElement('li');\r\n            itemEl.className = 'conf-item';\r\n            itemEl.innerHTML = `<div class=\"conf-num\">${displayNum}.<\/div><div class=\"conf-content\">${item}<\/div>`;\r\n            listEl.appendChild(itemEl);\r\n        });\r\n    }\r\n\r\n    function setupPagination() {\r\n        const paginationEl = document.getElementById('conf-pagination');\r\n        if(!paginationEl) return;\r\n        paginationEl.innerHTML = \"\";\r\n        let pageCount = Math.ceil(conferencePapers.length \/ rowsPerPage);\r\n\r\n        const addBtn = (text, onClick) => {\r\n            let btn = document.createElement('button');\r\n            btn.innerText = text;\r\n            btn.onclick = onClick;\r\n            paginationEl.appendChild(btn);\r\n            return btn;\r\n        };\r\n\r\n        addBtn(\"<<\", () => { currentPage = 1; update(); });\r\n        addBtn(\"<\", () => { if(currentPage > 1) { currentPage--; update(); } });\r\n\r\n        for (let i = 1; i <= pageCount; i++) {\r\n            let btn = addBtn(i, () => { currentPage = i; update(); });\r\n            if (currentPage === i) btn.className = 'active';\r\n        }\r\n\r\n        addBtn(\">\", () => { if(currentPage < pageCount) { currentPage++; update(); } });\r\n        addBtn(\">>\", () => { currentPage = pageCount; update(); });\r\n    }\r\n\r\n    function update() {\r\n        displayList(currentPage);\r\n        setupPagination();\r\n    }\r\n\r\n    update();\r\n})();\r\n<\/script>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-2e